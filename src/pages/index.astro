---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import ArrowIcon from '../components/ArrowIcon.astro';
import LocalRibbon from '../components/LocalRibbon.astro';
import CTA from '../components/CTA.astro';
import LeadForm from '../components/LeadForm.astro';
import hero from '../assets/central-ohio-collage.png';
import farm from '../assets/farm.jpg';
import bridge from '../assets/bridge-park.jpg';
import portrait from '../assets/zack-seated.jpg';
---
<Layout title="Zack LaChappelle | Central Ohio REALTOR®" description="Straightforward real estate guidance for buyers and sellers in Marysville, Union County, and Central Ohio.">
  <section class="home-hero">
    <div class="home-hero__media"><Image src={hero} alt="Central Ohio skyline, farmland, Bridge Park, and a neighborhood" loading="eager" /></div>
    <div class="container home-hero__content">
      <p class="eyebrow eyebrow--light">Marysville · Union County · Central Ohio</p>
      <h1>Move with a local in your <span>corner.</span></h1>
      <div class="home-hero__bottom">
        <p>Clear advice, consistent communication, and a plan built around what matters to you.</p>
        <div class="home-hero__actions">
          <a class="button" href="/contact/">Plan your next move <ArrowIcon /></a>
          <a class="button button--light" href="/about/">Meet Zack</a>
        </div>
      </div>
    </div>
    <span class="hero-note">REALTOR® with Red 1 Realty</span>
  </section>
  <LocalRibbon />

  <section class="intro">
    <div class="container intro__grid reveal">
      <div><p class="eyebrow">A better real estate experience</p></div>
      <div>
        <h2>Big decisions feel different with <span class="red">straight answers.</span></h2>
        <div class="intro__aside">
          <p>Buying or selling a home is personal. Zack brings market knowledge, responsive guidance, and a business-minded plan to every step, without losing sight of the people behind the move.</p>
          <a class="text-link" href="/about/">How Zack works <ArrowIcon /></a>
        </div>
      </div>
    </div>
  </section>

  <section class="paths">
    <div class="container">
      <div class="paths__head reveal">
        <h2>Where are you headed?</h2>
        <p class="lede">Start with the path that fits. We will build the strategy together.</p>
      </div>
      <div class="path-grid">
        <a class="path reveal" href="/buy/">
          <span class="path__number">01 / BUY</span>
          <div><h3>Find home.</h3><p>From first tour to final signature, understand the market and make an offer with confidence.</p><span class="text-link">Explore buying <ArrowIcon /></span></div>
        </a>
        <a class="path reveal" href="/sell/">
          <span class="path__number">02 / SELL</span>
          <div><h3>Move on.</h3><p>Price thoughtfully, prepare with purpose, and bring your home to market with a clear plan.</p><span class="text-link">Explore selling <ArrowIcon /></span></div>
        </a>
      </div>
    </div>
  </section>

  <section class="local-story">
    <div class="container local-story__grid">
      <div class="local-story__collage reveal">
        <Image src={farm} alt="Farmland at sunset in Central Ohio" />
        <Image src={bridge} alt="Bridge Park in Dublin, Ohio" />
      </div>
      <div class="reveal">
        <p class="eyebrow eyebrow--light">Local means more than a map pin</p>
        <h2>City energy. Small-town roots. Room to grow.</h2>
        <p>Zack serves a market with many versions of home, from established Marysville neighborhoods and Union County acreage to the connected communities across greater Columbus.</p>
        <a class="text-link" href="/about/">Why local perspective matters <ArrowIcon /></a>
      </div>
    </div>
  </section>

  <section class="trust">
    <div class="container trust__grid">
      <div class="reveal">
        <p class="eyebrow">The promise</p>
        <p class="trust__quote">“You should never have to wonder what happens next.”</p>
        <p class="lede">Expect honest communication, close attention to detail, and an advocate who stays accessible from the first conversation through closing.</p>
      </div>
      <div class="trust__image reveal"><Image src={portrait} alt="Zack LaChappelle seated outdoors" /></div>
    </div>
  </section>

  <section class="lead-capture">
    <div class="container lead-capture__grid">
      <div class="reveal">
        <p class="eyebrow eyebrow--light">Let’s make the first step easy</p>
        <h2>What move are you considering?</h2>
        <p>Leave your details and Zack will follow up to learn what you need, answer your first questions, and help you choose a sensible next step.</p>
        <a class="lead-capture__phone" href="tel:+16149748720">Call Zack <strong>614 974 8720</strong></a>
      </div>
      <LeadForm idPrefix="home-lead" compact={true} />
    </div>
  </section>

  <CTA />
</Layout>
