---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Process from '../components/Process.astro';
import CTA from '../components/CTA.astro';
import heroBackdrop from '../assets/hero-sold-sign.png';
import sellFeature from '../assets/sell-feature.avif';
const steps = [
  { title: 'Pricing with confidence', text: 'I will research recent comparable sales, active competition, and buyer behaviors to establish a credible range.' },
  { title: 'Preparing with purpose', text: "Identifying the updates and finishing touches that can enhance your home’s presentation, highlight its value, and make a lasting impression on buyers." },
  { title: 'Listing and Communication', text: 'Bringing your home to market with a coordinated plan and consistent communication as the offers pour in.' },
  { title: 'Evaluating the offer', text: 'Providing clear analysis on pricing, agreement terms, timing, contingencies, and the best path to the closing table.' },
];
---
<Layout title="Sell Your Central Ohio Home | Zack LaChappelle" description="Thoughtful pricing, preparation, and representation for home sellers in Marysville, Union County, and Central Ohio.">
  <section class="page-hero page-hero--tall">
    <div class="page-hero__backdrop page-hero__backdrop--right" aria-hidden="true"><Image src={heroBackdrop} alt="" loading="eager" widths={[640, 1024, 1600]} sizes="100vw" /></div>
    <div class="container page-hero__grid">
      <div><p class="eyebrow eyebrow--light">For sellers</p><h1>Bring your home to market with a plan.</h1></div>
      <p>A successful home sale begins with the right approach. I combine strategic pricing, thoughtful preparation, effective marketing, and strong negotiation to help you get the most from your sale.</p>
    </div>
  </section>
  <section class="page-section page-section--white">
    <div class="container section-grid section-grid--sticky">
      <div class="feature-image reveal"><Image src={sellFeature} alt="Bright open-concept family room prepared for market" widths={[480, 768, 1024, 1280]} sizes="(max-width: 900px) 100vw, 44vw" loading="lazy" /><p class="feature-image__caption">Thoughtful presentation helps buyers see how a home can live.</p></div>
      <div>
        <p class="eyebrow">The selling process</p>
        <h2 class="section-title">Prepared before the sign goes up.</h2>
        <Process steps={steps} />
      </div>
    </div>
  </section>
  <section class="page-section page-section--ink">
    <div class="container reveal">
      <p class="eyebrow eyebrow--light">More than a list price</p>
      <h2 class="section-title">A successful sale is the result of connected decisions.</h2>
      <div class="principles">
        <div class="principle"><h3>Positioning</h3><p>Present the home around its strongest real advantages and the buyers most likely to value them.</p></div>
        <div class="principle"><h3>Communication</h3><p>Know what is happening, what buyers are saying, and what the feedback means for your strategy.</p></div>
        <div class="principle"><h3>Negotiation</h3><p>Compare the full structure of each offer and protect the terms that matter through closing.</p></div>
      </div>
    </div>
  </section>
  <CTA eyebrow="Thinking about selling?" title="Start with an honest look at your options." text="A first conversation can help you understand timing, preparation, and the likely path to market, with no pressure to list." button="Talk about selling" />
</Layout>
