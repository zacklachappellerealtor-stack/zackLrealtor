---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Process from '../components/Process.astro';
import CTA from '../components/CTA.astro';
import heroBackdrop from '../assets/hero-kitchen-discussion.webp';
import buyFeature from '../assets/buy-feature.webp';
const steps = [
  { title: 'Set the direction', text: 'Discuss timing, financing, and your top priorities before the search begins.' },
  { title: 'Tour with purpose', text: "Let’s take a deeper dive. Looking beyond the photos, we will evaluate home condition, needs vs. wants analysis, associated values, location, and overall best fit." },
  { title: 'Writing your offer', text: 'Building terms around the property and your goals, then negotiating with the full picture in view.' },
  { title: 'Close with clarity', text: 'Keeping you informed through inspections, the appraisal process, required documents, and the final walk-through.' },
];
---
<Layout title="Buy a Home in Central Ohio | Zack LaChappelle" description="A practical, informed home buying process for Marysville, Union County, and Central Ohio buyers.">
  <section class="page-hero">
    <div class="page-hero__backdrop" aria-hidden="true"><Image src={heroBackdrop} alt="" loading="eager" widths={[640, 1024, 1600]} sizes="100vw" /></div>
    <div class="container page-hero__grid">
      <div><p class="eyebrow eyebrow--light">For buyers</p><h1>Find the right home, not just the next one.</h1></div>
      <p>A confident home purchase starts before your first showing. Understanding the market, your financing options, space needs, and timeline will help you make informed decisions and be ready when the right home comes along.</p>
    </div>
  </section>
  <section class="page-section page-section--white">
    <div class="container section-grid section-grid--sticky">
      <div class="feature-image reveal"><Image src={buyFeature} alt="Modern Central Ohio home with a welcoming front porch" widths={[480, 768, 1024, 1280]} sizes="(max-width: 900px) 100vw, 44vw" loading="lazy" /><p class="feature-image__caption">A search shaped around your life, not just a list of filters.</p></div>
      <div>
        <p class="eyebrow">The buying process</p>
        <h2 class="section-title">A clear step at every turn.</h2>
        <Process steps={steps} />
      </div>
    </div>
  </section>
  <section class="page-section">
    <div class="container reveal">
      <p class="eyebrow">What you can expect</p>
      <h2 class="section-title">Advice that stays useful when the market gets noisy.</h2>
      <div class="principles">
        <div class="principle"><h3>Local context</h3><p>Understand how value changes from one street, township, and school district to the next.</p></div>
        <div class="principle"><h3>Responsive guidance</h3><p>Get direct answers when timing matters, without pressure to move before you are ready.</p></div>
        <div class="principle"><h3>Thoughtful advocacy</h3><p>Make decisions with the facts, the risks, and your long-term goals clearly in view.</p></div>
      </div>
    </div>
  </section>
  <CTA eyebrow="Begin your home search" title="Know your next step before the first showing." text="Share what you are looking for and where you are in the process. I will help you map the path forward." button="Talk about buying" />
</Layout>
