---
const places = ['Marysville', 'Richwood', 'Plain City', 'Milford Center', 'Magnetic Springs', 'Raymond', 'Broadway', 'Unionville Center', 'Dublin', 'Columbus', 'Union County', 'Central Ohio'];
---
<div class="ribbon" aria-label="Service area">
  <div class="ribbon__track">
    {[...places, ...places].map((place) => <span><i></i>{place}</span>)}
  </div>
</div>
